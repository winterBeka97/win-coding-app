<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="windows_app_coding.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:windows_app_coding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
            <Border Width="60" />
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.RegisterPrompt, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Register" Click="RegisterBtn" />
                <TextBlock Text="{x:Bind ViewModel.LoginPrompt, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Login" Click="LoginBtn" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
